    J["Text Overlay<br/>Campaign Message"]
    K["Logo Overlay<br/>Brand Identity"]
    L["Compliance Check<br/>Colors & Logo"]
    M["Text Moderation<br/>Prohibited Words"]
  end

  subgraph "Output Organization"
    N["Structured Output<br/>output/{product}/"]
    O["1:1 Square<br/>1024x1024"]
    P["9:16 Portrait<br/>1080x1920"]
