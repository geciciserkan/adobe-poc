%% Mermaid diagram: Creative Automation Pipeline Architecture
flowchart TB
  subgraph "Input Layer"
    A["Campaign Brief<br/>YAML/JSON"]
    B["Input Assets<br/>input/assets/"]
    C["Brand Assets<br/>logo.png"]
  end

  subgraph "Orchestration"
    D["Pipeline Orchestrator<br/>main.py"]
    E["Asset Ingestion<br/>asset_ingestion.py"]
  end

  subgraph "Asset Generation"
    F{"Asset Check"}
    G["Reuse Existing<br/>Local Assets"]
    H["Generate New<br/>OpenAI DALL-E 3"]
